# ============================================================
# CMO Agent Configuration
# Copy this file to .env and fill in the values.
# Run `cmo setup` for an interactive configuration wizard.
# ============================================================

# ── Core Settings ────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
DEBUG=false

# ── LLM Provider ────────────────────────────────────────────
# Required: at least one API key
LLM_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model assignments (defaults work well for most users)
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_SCANNING=claude-haiku-4-5-20251001
LLM_MODEL_WRITING=claude-sonnet-4-6
LLM_MODEL_PREMIUM=claude-opus-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ── n8n Integration (optional) ──────────────────────────────
# Connect to your n8n instance for workflow automation
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ── Image Generation (optional) ─────────────────────────────
# Enable image generation by providing one or more keys
GEMINI_API_KEY=                  # Recommended: best quality images
FAL_API_KEY=                     # For SDXL and video generation
# OPENAI_API_KEY already set above (used for DALL-E if enabled)

# ── Google Workspace (optional) ──────────────────────────────
# For Google Docs, Sheets, and Slides agents
GOOGLE_CREDENTIALS_PATH=         # Service account JSON path
GOOGLE_OAUTH_TOKEN_PATH=         # OAuth2 token JSON path

# ── Supabase Media Storage (optional) ────────────────────────
# Centralized CDN for generated media assets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cmo-media

# ── Slack Bot (optional) ─────────────────────────────────────
# For Slack bot interaction surface
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ADMIN_USERS=               # Comma-separated Slack user IDs

# Slack notification channels (leave blank to disable)
SLACK_NOTIFICATION_CHANNEL=
SLACK_GROWTH_IDEAS_CHANNEL=

# ── Workspace Settings ───────────────────────────────────────
DEFAULT_WORKSPACE=               # Set during `cmo setup`
BRAND_VOICES_DIR=./data/brand_voices
DB_PATH=./data/cmo_agent.db

# ── Agent Toggling ───────────────────────────────────────────
# Comma-separated list of agent IDs to disable.
# Example: DISABLED_AGENTS=dsdn_ideas_agent,dsdn_tiktok_agent,outreach_scanner_agent
DISABLED_AGENTS=

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_ENABLED=false
GROWTH_IDEAS_SCHEDULE_HOUR=6
GROWTH_IDEAS_SCHEDULE_MINUTE=0
GROWTH_IDEAS_TZ_OFFSET=-6.0
GROWTH_IDEAS_FREQUENCY_DAYS=1

# ── Quality Refinement ───────────────────────────────────────
REFINEMENT_ENABLED=true

# ── Router (token optimization) ──────────────────────────────
ROUTER_ENABLED=true
ROUTER_MODEL=claude-haiku-4-5-20251001

# ── GA4 Analytics (optional) ─────────────────────────────────
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GTM_CONTAINER_ID=

# ── Affiliate Networks (optional) ──────────────────────────
# CJ Affiliate: get token at developers.cj.com > Authentication > Personal Access Tokens
CJ_API_TOKEN=
CJ_COMPANY_ID=                   # Your CJ publisher company ID (7 digits)

# Impact.com: Dashboard > Settings > Technical > API
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# Google Sheet ID from build_affiliate_research_sheet.py output
AFFILIATE_RESEARCH_SHEET_ID=

# ── Customer.io (optional) ──────────────────────────────────
CUSTOMERIO_APP_API_KEY=

# ── Video / Motion Graphics (optional) ──────────────────────
VIDEO_OUTPUT_DIR=./data/videos
REMOTION_PROJECT_DIR=./data/remotion
MOTION_OUTPUT_DIR=./data/motion_graphics
