# Dockerfile for CMO Agent Service Layer
# Exposes FastAPI endpoints that OpenClaw skills call

FROM python:3.11-slim

WORKDIR /app

# System deps for Pillow (text overlay) and general build
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libjpeg-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml setup.cfg setup.py ./
COPY src/ ./src/

# Install the project
RUN pip install --no-cache-dir -e .

# Copy service layer
COPY openclaw/services/ ./openclaw/services/

# Copy data directory structure (brand voices, fonts, etc.)
# Actual data is mounted as a volume in docker-compose
COPY data/brand_voices/ ./data/brand_voices/
COPY data/fonts/ ./data/fonts/

EXPOSE 8100

# Run the FastAPI service layer
CMD ["uvicorn", "openclaw.services.api:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "2"]
